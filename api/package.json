{
  "name": "mood-music-api-docs",
  "private": true,
  "version": "1.0.0",
  "description": "OpenAPI contract, linting, mock server and published docs for the Mood-Based Music Discovery API",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "mock": "prism mock openapi.yaml -p 4010",
    "docs": "redocly build-docs openapi.yaml -o docs/index.html",
    "preview": "redocly preview-docs openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.82.0",
    "@stoplight/prism-cli": "^5.6.0"
  }
}
